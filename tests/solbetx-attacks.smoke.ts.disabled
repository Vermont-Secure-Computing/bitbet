import * as anchor from "@coral-xyz/anchor";
import { Program } from "@coral-xyz/anchor";
import { expect } from "chai";

import { BettingContract } from "../target/types/betting_contract";

describe("SolBetX attack suite", () => {
    const provider = anchor.AnchorProvider.env();
    anchor.setProvider(provider);

    const program =
        anchor.workspace.BettingContract as Program<BettingContract>;

    it("loads the SolBetX program client", async () => {
        console.log(
            "RPC:",
            provider.connection.rpcEndpoint
        );

        console.log(
            "Wallet:",
            provider.wallet.publicKey.toBase58()
        );

        console.log(
            "Program:",
            program.programId.toBase58()
        );

        expect(program.programId.toBase58()).to.equal(
            "B8XxuJynFpSVkuYumB6mXFxHEkDvdddavCudCHH7NJWM"
        );
    });
});